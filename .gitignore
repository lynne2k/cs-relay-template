# Personal configuration and runtime state are never release inputs.
/.env
/.env.*
!/.env.example
/config.json
/config.local.*
/*.local.json
/runtime/
/jobs/
/assets/
/evidence/
/qa/
/outputs/
/downloads/
/chatcut-import/
/renders/
/reports/
/private/
/local/

# Authentication, browser profiles, and SSH material.
**/cookies*
**/session*
**/browser-profile/
**/.ssh/
**/.aws/
**/credentials*
*.pem
*.key
id_rsa*
id_ed25519*

# Downloaded models, generated media, archives, and databases.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.flac
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.zip
*.tar
*.gz
*.7z
*.sqlite*
*.db
*.log

# Tool caches and platform metadata.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
node_modules/
.DS_Store
._*
.idea/
.vscode/
dist/
build/
*.egg-info/

# Real photos stay local. Small synthetic fixtures require an explicit,
# content-hash-pinned release allowlist entry before they pass the guard.
*.png
*.jpg
*.jpeg
*.webp
*.gif
!tests/fixtures/synthetic/*.png
!examples/synthetic/*.png
